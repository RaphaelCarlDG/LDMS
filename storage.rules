rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Document files — authenticated users can upload and read
    match /documents/{userId}/{allPaths=**} {
      // Any authenticated user can read document files
      allow read: if request.auth != null;

      // Only the owning user can write/delete their uploads — account must be active
      allow write: if request.auth != null
        && request.auth.uid == userId
        && firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data.isActive == true;
    }

  }
}
